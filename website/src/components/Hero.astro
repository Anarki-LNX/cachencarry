---
import Icon from './Icon.astro';
import { REPO, RELEASE } from '~/config/site';
import { type Locale, t, anchors } from '~/i18n';

// First screen: claim, two actions and a schematic network. The diagram is a picture
// of the principle (one fetch from the Internet, many deliveries on the LAN). It
// shows no numbers and is labelled as a schematic.
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
const h = tr.hero;
const ways = [
  { key: 'proxmox', icon: 'terminal' },
  { key: 'docker', icon: 'package' },
  { key: 'release', icon: 'server' },
] as const;
const ext = { target: '_blank', rel: 'noopener noreferrer' } as const;

// Layout in a 640 × 500 viewBox: the Internet on the left, Cache & Carry in the middle
// of the LAN and the clients in a half circle around it. Machines of the same family
// sit next to each other: a package only helps machines that use the same repository.
// CachyOS pulls many packages from the Arch repositories, so it shares the Arch file.
const cx = 392;
const cy = 252;
const inetX = 70;
const divider = 182;
const RX = 168;
const RY = 192;
const BOX_W = 134;
const BOX_H = 30;
const clients = [
  { a: -128, name: 'Debian · PC' },
  { a: -92, name: 'Debian · NAS' },
  { a: -56, name: 'Debian · LXC' },
  { a: -19, name: 'Ubuntu · PC' },
  { a: 19, name: 'Ubuntu · Laptop' },
  { a: 56, name: 'Arch · PC' },
  { a: 92, name: 'Arch · Laptop' },
  { a: 128, name: 'CachyOS' },
].map((c) => {
  const r = (c.a * Math.PI) / 180;
  return { ...c, x: cx + RX * Math.cos(r), y: cy + RY * Math.sin(r) };
});
const r1 = (n: number) => Math.round(n * 10) / 10;
/** Straight line from the edge of the cache circle to the edge of the client box. */
const pathTo = (c: { x: number; y: number }) => {
  const dx = c.x - cx;
  const dy = c.y - cy;
  const len = Math.hypot(dx, dy);
  const ux = dx / len;
  const uy = dy / len;
  const toBox = Math.min(BOX_W / 2 / Math.max(Math.abs(ux), 1e-6), BOX_H / 2 / Math.max(Math.abs(uy), 1e-6)) + 4;
  return `M${r1(cx + ux * 40)} ${r1(cy + uy * 40)} L ${r1(c.x - ux * toBox)} ${r1(c.y - uy * toBox)}`;
};
const inPath = `M${inetX + 32} ${cy} L ${cx - 40} ${cy}`;

// One loop of DURS seconds. The groups overlap, so several machines send and receive at
// almost the same time:
//   Debian: the PC misses, the file is fetched once, NAS and LXC ask together and hit.
//   Ubuntu: the PC misses while Debian is still busy, the laptop hits later.
//   Arch: the PC and CachyOS ask for the same file at once. One download serves both
//   (the coalescing feature), the Arch laptop hits afterwards.
const DURS = 13;
const DUR = `${DURS}s`;
type Kind = 'req' | 'in' | 'hit';
interface Move {
  path: string;
  t0: number;
  t1: number;
  reverse: boolean;
  kind: Kind;
}
const sec = (t: number) => t / DURS;
const ask = (c: number, t: number): Move => ({
  path: `p-out-${c}`,
  t0: sec(t),
  t1: sec(t + 0.65),
  reverse: true,
  kind: 'req',
});
const give = (c: number, t: number): Move => ({
  path: `p-out-${c}`,
  t0: sec(t),
  t1: sec(t + 0.6),
  reverse: false,
  kind: 'hit',
});
const up = (t: number): Move => ({ path: 'p-in', t0: sec(t), t1: sec(t + 0.5), reverse: true, kind: 'req' });
const down = (t: number): Move => ({ path: 'p-in', t0: sec(t), t1: sec(t + 0.95), reverse: false, kind: 'in' });
const moves: Move[] = [
  // Debian
  ask(0, 0.2),
  up(0.95),
  down(1.55),
  give(0, 2.6),
  ask(1, 3.5),
  ask(2, 3.7),
  give(1, 4.25),
  give(2, 4.45),
  // Ubuntu, starting while Debian is still running
  ask(3, 2.0),
  up(2.75),
  down(3.35),
  give(3, 4.4),
  ask(4, 6.0),
  give(4, 6.75),
  // Arch and CachyOS ask together, one download serves both
  ask(5, 6.3),
  ask(7, 6.45),
  up(7.2),
  down(7.8),
  give(5, 8.85),
  give(7, 8.9),
  ask(6, 10.1),
  give(6, 10.85),
  // a last round of quick hits so the end of the loop is not empty
  ask(1, 11.2),
  ask(4, 11.35),
  give(1, 11.95),
  give(4, 12.1),
];
const missWin: [number, number][] = [
  [sec(0.95), sec(5.0)],
  [sec(7.2), sec(9.5)],
];
const hitWin: [number, number][] = [
  [sec(5.1), sec(7.1)],
  [sec(10.1), sec(12.8)],
];
const f = (n: number) => n.toFixed(4);
const motion = (m: Move) => ({
  keyPoints: m.reverse ? '1;1;0;0' : '0;0;1;1',
  keyTimes: `0;${f(m.t0)};${f(m.t1)};1`,
});
/** Opacity 0 outside the given windows, 1 inside, with short fades. */
const windows = (list: [number, number][]) => {
  const values = ['0'];
  const times = ['0'];
  for (const [t0, t1] of list) {
    values.push('0', '1', '1', '0');
    times.push(f(t0), f(t0 + 0.008), f(t1 - 0.008), f(t1));
  }
  values.push('0');
  times.push('1');
  return { values: values.join(';'), keyTimes: times.join(';') };
};
const fade = (t0: number, t1: number) => windows([[t0, t1]]);
// a client's LED lights up when its file arrives
const served = clients.map((_, i) => moves.filter((m) => m.kind === 'hit' && m.path === `p-out-${i}`).map((m) => m.t1));
const ledPulse = (times: number[]) => {
  const values = ['4'];
  const kt = ['0'];
  for (const t of times) {
    values.push('4', '7', '4');
    kt.push(f(t), f(t + 0.012), f(t + 0.035));
  }
  values.push('4');
  kt.push('1');
  return { values: values.join(';'), keyTimes: kt.join(';') };
};
const missWindow = windows(missWin);
const hitWindow = windows(hitWin);
---

<section class="hero" id={anchors.overview} aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="label hero__eyebrow">
        <span class="num">●</span> {h.eyebrow}
      </p>
      <h1 id="hero-title" class="hero__title">
        Cache <em>&amp;</em> Carry
      </h1>
      <p class="hero__tagline">{h.tagline}</p>
      <p class="lead hero__lead">{h.lead}</p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href={REPO.url} {...ext}>
          <Icon name="github" size={18} />
          <span>{h.ctaGithub}</span>
          <span class="visually-hidden">{tr.a11y.newTab}</span>
        </a>
        <a class="btn btn--ghost" href={`#${anchors.install}`}>
          <span>{h.ctaInstall}</span>
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <nav class="hero__ways" aria-label={h.ways}>
        <span class="label">{h.ways}</span>
        <ul role="list">
          {ways.map((w) => (
            <li>
              <a href={`#${anchors.install}`} data-tab-target={`inst-tab-${w.key}`}>
                <Icon name={w.icon} size={15} />
                {tr.install.methods[w.key].tab}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="hero__meta">
        <span class="hero__pill">
          <Icon name="shield" size={14} /> {h.license}
        </span>
        <a class="hero__pill hero__pill--link" href={RELEASE.url} {...ext}>
          <Icon name="git-branch" size={14} />
          {h.release} v{RELEASE.version}
          <span class="visually-hidden">{tr.a11y.newTab}</span>
        </a>
      </p>
    </div>

    <figure class="hero__fig">
      <svg class="net" viewBox="0 0 640 500" role="img" aria-labelledby="net-title">
        <title id="net-title">{h.diagramLabel}</title>
        <defs>
          <linearGradient id="g-in" x1="0" x2="1">
            <stop offset="0" stop-color="#5b8cff" stop-opacity="0.25"></stop>
            <stop offset="1" stop-color="#5b8cff" stop-opacity="0.8"></stop>
          </linearGradient>
          <radialGradient id="g-core">
            <stop offset="0" stop-color="#34d399" stop-opacity="0.35"></stop>
            <stop offset="1" stop-color="#34d399" stop-opacity="0"></stop>
          </radialGradient>
        </defs>

        <!-- frame around the whole picture, split into Internet and LAN -->
        <rect class="net__zone" x="6" y="18" width="628" height="474" rx="22"></rect>
        <path class="net__divider" d={`M${divider} 34 V 476`}></path>
        <text class="net__zone-label net__zone-label--inet" x="26" y="44">
          {h.diagramInternet}
        </text>
        <text class="net__zone-label" x="614" y="44" text-anchor="end">
          {h.diagramLan}
        </text>

        <!-- Internet -->
        <g class="net__inet">
          <circle cx={inetX} cy={cy} r="30"></circle>
          <path
            d={`M${inetX - 30} ${cy}h60M${inetX} ${cy - 30}a46 46 0 0 1 0 60M${inetX} ${cy - 30}a46 46 0 0 0 0 60`}
          ></path>
          <text x={inetX} y={cy + 54} text-anchor="middle" class="net__cap">
            {h.diagramMirror}
          </text>
        </g>

        <!-- upstream line -->
        <path id="p-in" class="net__in" d={inPath}></path>
        <text x={(divider + cx - 40) / 2} y={cy - 12} text-anchor="middle" class="net__once">
          {h.diagramOnce}
        </text>

        <!-- delivery lines -->
        {clients.map((c, i) => (
          <path id={`p-out-${i}`} class="net__out" d={pathTo(c)} />
        ))}

        <!-- cache core -->
        <circle cx={cx} cy={cy} r="92" fill="url(#g-core)" class="net__halo"></circle>
        <circle cx={cx} cy={cy} r="36" class="net__core"></circle>
        <g transform={`translate(${cx - 16} ${cy - 16}) scale(0.5)`} class="net__mark">
          <path d="M7 13h8.5l5.2 29.5h31.3"></path>
          <rect x="25" y="14.5" width="25" height="21.5" rx="4"></rect>
          <path class="net__mark-arrow" d="M37.5 20v9.5m-4.7-4.3 4.7 4.7 4.7-4.7"></path>
          <circle cx="26" cy="52" r="3.3"></circle>
          <circle cx="46.5" cy="52" r="3.3"></circle>
        </g>
        <text x={cx} y={cy + 58} text-anchor="middle" class="net__cap">
          {h.diagramCache}
        </text>

        <!-- MISS on the Internet side, HIT on the LAN side, shown in step with the packets -->
        <g class="net__badge net__badge--miss" opacity="0" aria-hidden="true">
          <rect x={cx - 82} y={cy - 58} width="52" height="20" rx="10"></rect>
          <text x={cx - 56} y={cy - 44} text-anchor="middle">
            MISS
          </text>
          <animate attributeName="opacity" dur={DUR} repeatCount="indefinite" {...missWindow} />
        </g>
        <g class="net__badge net__badge--hit" opacity="0" aria-hidden="true">
          <rect x={cx - 22} y={cy + 66} width="44" height="20" rx="10"></rect>
          <text x={cx} y={cy + 80} text-anchor="middle">
            HIT
          </text>
          <animate attributeName="opacity" dur={DUR} repeatCount="indefinite" {...hitWindow} />
        </g>

        <!-- clients -->
        {clients.map((c, i) => (
          <g class="net__client">
            <rect x={r1(c.x - BOX_W / 2)} y={r1(c.y - BOX_H / 2)} width={BOX_W} height={BOX_H} rx="9" />
            <circle cx={r1(c.x - BOX_W / 2 + 14)} cy={r1(c.y)} r="4" class="net__led">
              {served[i]!.length > 0 && (
                <animate attributeName="r" dur={DUR} repeatCount="indefinite" {...ledPulse(served[i]!)} />
              )}
            </circle>
            <text x={r1(c.x - BOX_W / 2 + 25)} y={r1(c.y + 4.3)} class="net__name">
              {c.name}
            </text>
          </g>
        ))}

        <!-- moving packets: violet = request, blue = from the Internet, green = from the cache -->
        <g class="net__packets" aria-hidden="true">
          {moves.map((m) => (
            <circle r={m.kind === 'req' ? 4 : 5} class={`pk pk--${m.kind}`} opacity="0">
              <animateMotion dur={DUR} repeatCount="indefinite" calcMode="linear" {...motion(m)}>
                <mpath href={`#${m.path}`} />
              </animateMotion>
              <animate attributeName="opacity" dur={DUR} repeatCount="indefinite" {...fade(m.t0, m.t1)} />
            </circle>
          ))}
        </g>
      </svg>
      <ul role="list" class="net__legend">
        <li>
          <span class="dot dot--req"></span>
          {h.legendRequest}
        </li>
        <li>
          <span class="dot dot--in"></span>
          {h.legendInternet}
        </li>
        <li>
          <span class="dot dot--hit"></span>
          {h.legendCache}
        </li>
      </ul>
      <figcaption class="hero__note">{h.diagramNote}</figcaption>
    </figure>
  </div>

  <div class="container">
    <ul role="list" class="facts">
      {tr.facts.map((f) => (
        <li class="facts__item">
          <span class="facts__value">{f.value}</span>
          <span class="facts__label">{f.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 5vw, 7rem) var(--s-12);
  }
  .hero__glow {
    position: absolute;
    inset: -20% -10% auto 30%;
    height: 90%;
    background:
      radial-gradient(40% 50% at 60% 40%, rgb(52 211 153 / 0.16), transparent 70%),
      radial-gradient(35% 40% at 85% 20%, rgb(91 140 255 / 0.14), transparent 70%),
      radial-gradient(30% 35% at 70% 75%, rgb(167 139 250 / 0.1), transparent 70%);
    pointer-events: none;
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(70% 60% at 65% 40%, #000, transparent 75%);
    -webkit-mask-image: radial-gradient(70% 60% at 65% 40%, #000, transparent 75%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--s-12);
    align-items: center;
  }
  .hero__copy {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .hero__eyebrow .num {
    color: var(--gate);
    animation: blink 2.4s ease-in-out infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.35;
    }
  }
  .hero__title {
    font-size: var(--fs-hero);
    line-height: 0.92;
    letter-spacing: -0.025em;
  }
  .hero__title em {
    color: var(--gate);
    font-style: italic;
  }
  .hero__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.3vw, 2.25rem);
    font-style: italic;
    line-height: 1.15;
    background: linear-gradient(90deg, var(--text), var(--water-ink) 60%, var(--violet-ink));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__lead {
    max-width: 34rem;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  .hero__ways {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
  }
  .hero__ways ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
  }
  .hero__ways a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 36px;
    padding: 0 0.9rem;
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
    color: var(--text);
    font-size: 0.875rem;
    text-decoration: none;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }
  .hero__ways a:hover,
  .hero__ways a:focus-visible {
    border-color: var(--ok);
    background: var(--ok-wash);
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 32px;
    padding: 0 0.8rem;
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
  .hero__pill--link {
    text-decoration: none;
  }
  .hero__pill--link:hover {
    color: var(--text);
    border-color: var(--line-3);
  }
  .hero__fig {
    position: relative;
    width: 100%;
    max-width: 620px;
    justify-self: center;
  }
  .hero__note {
    margin-top: var(--s-2);
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-align: right;
    text-transform: uppercase;
  }

  /* diagram */
  .net {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .net__zone {
    fill: rgb(103 232 249 / 0.025);
    stroke: rgb(103 232 249 / 0.18);
    stroke-dasharray: 4 6;
  }
  .net__divider {
    fill: none;
    stroke: rgb(103 232 249 / 0.22);
    stroke-dasharray: 2 6;
  }
  .net__zone-label--inet {
    fill: var(--in-ink) !important;
  }
  .net__zone-label {
    fill: var(--water-ink);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
  }
  .net__inet circle,
  .net__inet path {
    fill: none;
    stroke: var(--in);
    stroke-width: 1.6;
  }
  .net__inet circle {
    fill: rgb(91 140 255 / 0.08);
  }
  .net__cap {
    fill: var(--text);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 560;
  }
  .net__sub {
    fill: var(--faint);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .net__in {
    fill: none;
    stroke: url(#g-in);
    stroke-width: 2;
  }
  .net__once {
    fill: var(--in-ink);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
  }
  .net__out {
    fill: none;
    stroke: rgb(52 211 153 / 0.55);
    stroke-width: 1.4;
    stroke-dasharray: 3 5;
    animation: flow 1.6s linear infinite;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -16;
    }
  }
  .net__core {
    fill: #0b1a14;
    stroke: var(--gate);
    stroke-width: 2;
    filter: drop-shadow(0 0 18px rgb(52 211 153 / 0.45));
  }
  .net__halo {
    animation: breathe 6s ease-in-out infinite;
    transform-origin: 392px 252px;
  }
  @keyframes breathe {
    50% {
      opacity: 0.55;
      transform: scale(0.92);
    }
  }
  .net__mark path,
  .net__mark rect {
    fill: none;
    stroke: var(--gate);
    stroke-width: 4.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .net__mark .net__mark-arrow {
    stroke: #f8fafc;
    stroke-width: 3.6;
  }
  .net__mark circle {
    fill: var(--gate);
  }
  .net__client rect {
    fill: rgb(13 18 24 / 0.92);
    stroke: var(--line-3);
  }
  .net__led {
    fill: var(--gate);
  }
  .net__name {
    fill: var(--soft);
    font-family: var(--font-mono);
    font-size: 11.5px;
  }
  .pk--req {
    fill: var(--violet-ink);
    filter: drop-shadow(0 0 6px rgb(167 139 250 / 0.9));
  }
  .net__badge text {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }
  .net__badge--miss rect {
    fill: rgb(91 140 255 / 0.18);
    stroke: var(--in);
  }
  .net__badge--miss text {
    fill: var(--in-ink);
  }
  .net__badge--hit rect {
    fill: rgb(52 211 153 / 0.16);
    stroke: var(--gate);
  }
  .net__badge--hit text {
    fill: var(--gate-ink);
  }
  .net__legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-2);
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .net__legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .dot--req {
    background: var(--violet-ink);
  }
  .dot--in {
    background: var(--in-ink);
  }
  .dot--hit {
    background: var(--gate-ink);
  }
  .pk--in {
    fill: var(--in-ink);
    filter: drop-shadow(0 0 6px rgb(91 140 255 / 0.9));
  }
  .pk--hit {
    fill: var(--gate-ink);
    filter: drop-shadow(0 0 6px rgb(52 211 153 / 0.9));
  }

  /* facts */
  .facts {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    margin-top: var(--s-16);
