---
import Icon from './Icon.astro';
import { REPO, donateUrl } from '~/config/site';
import { type Locale, t, anchors, otherLocale, homePath } from '~/i18n';

// Sticky header: brand, section links, language switch, GitHub and Support.
// The mobile menu is a <details> element, so it works without JavaScript.
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
const other = otherLocale(locale);
const links = [
  { href: `#${anchors.features}`, label: tr.nav.features },
  { href: `#${anchors.how}`, label: tr.nav.how },
  { href: `#${anchors.screenshots}`, label: tr.nav.screenshots },
  { href: `#${anchors.tutorials}`, label: tr.nav.tutorials },
  { href: `#${anchors.install}`, label: tr.nav.install },
];
---

<header class="hdr" data-header>
  <div class="container hdr__bar">
    <a class="hdr__brand" href={homePath(locale)} aria-label={tr.a11y.home}>
      <img src="/brand/mark-on-dark.svg" alt="" width="30" height="30" />
      <span class="hdr__name">
        Cache <span class="hdr__amp">&amp;</span> Carry
      </span>
    </a>

    <nav class="hdr__nav" aria-label={tr.a11y.mainNav}>
      <ul role="list">
        {links.map((l) => (
          <li>
            <a href={l.href} data-spy>
              {l.label}
            </a>
          </li>
        ))}
        <li>
          <a href={REPO.readme} target="_blank" rel="noopener noreferrer">
            {tr.nav.docs}
            <Icon name="arrow-up-right" size={13} />
            <span class="visually-hidden">{tr.a11y.newTab}</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="hdr__actions">
      <a class="hdr__lang" href={homePath(other)} hreflang={other} lang={other} aria-label={tr.a11y.langSwitch}>
        <span class:list={{ on: locale === 'de' }}>DE</span>
        <span class="hdr__slash" aria-hidden="true">
          /
        </span>
        <span class:list={{ on: locale === 'en' }}>EN</span>
      </a>
      <a class="hdr__icon" href={REPO.url} target="_blank" rel="noopener noreferrer">
        <Icon name="github" size={18} />
        <span class="visually-hidden">
          {tr.nav.github} {tr.a11y.newTab}
        </span>
      </a>
      {donateUrl && (
        <a class="hdr__support" href={`#${anchors.support}`}>
          <Icon name="heart" size={15} />
          <span>{tr.nav.support}</span>
        </a>
      )}

      <details class="hdr__menu" data-disclosure data-mobile-nav>
        <summary class="hdr__toggle" aria-label={tr.a11y.menu}>
          <span class="hdr__ico-open">
            <Icon name="menu" size={20} />
          </span>
          <span class="hdr__ico-close">
            <Icon name="close" size={20} />
          </span>
        </summary>
        <div class="hdr__panel">
          <nav aria-label={tr.a11y.menu}>
            <ul role="list">
              {links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
              <li>
                <a href={REPO.readme} target="_blank" rel="noopener noreferrer">
                  {tr.nav.docs} <Icon name="arrow-up-right" size={14} />
                  <span class="visually-hidden">{tr.a11y.newTab}</span>
                </a>
              </li>
              <li>
                <a href={REPO.url} target="_blank" rel="noopener noreferrer">
                  {tr.nav.github} <Icon name="arrow-up-right" size={14} />
                  <span class="visually-hidden">{tr.a11y.newTab}</span>
                </a>
              </li>
              {donateUrl && (
                <li>
                  <a href={`#${anchors.support}`}>{tr.nav.support}</a>
                </li>
              )}
            </ul>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  import '~/scripts/nav';
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    background: rgb(7 9 13 / 0.6);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    transition:
      border-color var(--t-med),
      background-color var(--t-med);
  }
  .hdr:global(.is-scrolled) {
    border-bottom-color: var(--line);
    background: rgb(7 9 13 / 0.82);
  }
  .hdr__bar {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    height: var(--header-h);
  }
  .hdr__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .hdr__brand:hover {
    color: var(--text);
  }
  .hdr__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .hdr__amp {
    color: var(--gate);
    font-style: italic;
  }
  .hdr__nav {
    display: none;
    margin-inline: auto;
  }
  .hdr__nav ul {
    display: flex;
    gap: var(--s-1);
  }
  .hdr__nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 40px;
    padding: 0 0.8rem;
    border-radius: var(--r-pill);
    color: var(--muted);
    font-size: 0.9375rem;
    text-decoration: none;
    transition:
      color var(--t-fast),
      background-color var(--t-fast);
  }
  .hdr__nav a:hover,
  .hdr__nav a:global(.is-active) {
    color: var(--text);
    background: rgb(255 255 255 / 0.05);
  }
  .hdr__nav a:global(.is-active) {
    box-shadow: inset 0 -2px 0 rgb(52 211 153 / 0.7);
  }
  .hdr__actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-left: auto;
  }
  .hdr__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: var(--tap);
    padding: 0 0.75rem;
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .hdr__lang .on {
    color: var(--text);
  }
  .hdr__lang:hover {
    border-color: var(--line-3);
    color: var(--muted);
  }
  .hdr__slash {
    color: var(--line-3);
  }
  .hdr__icon {
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 1px solid var(--line-2);
    border-radius: 50%;
    color: var(--soft);
  }
  .hdr__icon:hover {
    border-color: var(--line-3);
    color: var(--text);
  }
  .hdr__support {
    display: none;
    align-items: center;
    gap: 0.45rem;
    min-height: var(--tap);
    padding: 0 1rem;
    border: 1px solid rgb(52 211 153 / 0.35);
    border-radius: var(--r-pill);
    background: var(--gate-wash);
    color: var(--gate-ink);
    font-size: 0.875rem;
    font-weight: 540;
    text-decoration: none;
  }
  .hdr__support:hover {
    border-color: rgb(52 211 153 / 0.6);
    color: var(--text);
  }
  .hdr__menu {
    position: relative;
  }
  .hdr__toggle {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 1px solid var(--line-2);
    border-radius: 50%;
    color: var(--text);
    list-style: none;
    cursor: pointer;
  }
  .hdr__toggle::-webkit-details-marker {
    display: none;
  }
  .hdr__ico-close,
  .hdr__menu[open] .hdr__ico-open {
    display: none;
  }
  .hdr__menu[open] .hdr__ico-close {
    display: grid;
  }
  .hdr__ico-open {
    display: grid;
  }
  .hdr__panel {
    position: fixed;
    inset: var(--header-h) 0 auto 0;
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    padding: var(--s-4) var(--gutter) var(--s-8);
    border-bottom: 1px solid var(--line-2);
    background: rgb(7 9 13 / 0.97);
  }
  .hdr__panel a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 52px;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    font-size: 1.125rem;
    text-decoration: none;
  }
  @media (min-width: 640px) {
    .hdr__support {
      display: inline-flex;
    }
  }
  @media (min-width: 1080px) {
    .hdr__nav {
      display: block;
    }
    .hdr__menu {
      display: none;
    }
    .hdr__actions {
      margin-left: 0;
    }
  }
</style>
