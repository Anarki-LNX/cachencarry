---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '~/styles/global.css';

// The two files every page needs first; the same files the CSS above points to,
// so Vite gives them the same hashed URL and the preload is reused.
import serifUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { SITE, REPO, RELEASE } from '~/config/site';
import { type Locale, locales, t, homePath } from '~/i18n';

interface Props {
  /** null for the language choice page at "/" */
  locale: Locale | null;
  title: string;
  description: string;
  noindex?: boolean | undefined;
  /** false: no hreflang alternates (404) */
  alternates?: boolean | undefined;
  /** show header and footer */
  chrome?: boolean | undefined;
  /** add the SoftwareApplication JSON-LD (home pages) */
  softwareJsonLd?: boolean | undefined;
}

const {
  locale,
  title,
  description,
  noindex = false,
  alternates = true,
  chrome = true,
  softwareJsonLd = false,
} = Astro.props;

const lang: Locale = locale ?? 'de';
const tr = t(lang);
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL('/brand/social-card.png', SITE.url).href;
const alts = alternates ? locales.map((l) => ({ hreflang: l, href: new URL(homePath(l), SITE.url).href })) : [];

const jsonLd = softwareJsonLd
  ? {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: SITE.name,
      description,
      url: new URL(homePath(lang), SITE.url).href,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux',
      softwareVersion: RELEASE.version,
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      codeRepository: REPO.url,
      downloadUrl: REPO.latestRelease,
      isAccessibleForFree: true,
      inLanguage: ['de', 'en'],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      author: { '@type': 'Organization', name: 'LOOP OUT TECH', url: 'https://loopout.tech' },
    }
  : null;
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    {alts.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    {alts.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL('/', SITE.url).href} />}

    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#07090d" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={tr.meta.ogAlt} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    {locale && <meta property="og:locale:alternate" content={lang === 'de' ? 'en_US' : 'de_DE'} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={tr.meta.ogAlt} />

    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLdText} />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {tr.a11y.skip}
    </a>
    {chrome && locale && <Header locale={locale} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {chrome && locale && <Footer locale={locale} />}
    <script>
      import '~/scripts/reveal';
    </script>
  </body>
</html>

<style>
  main {
    display: block;
    outline: none;
  }
</style>
