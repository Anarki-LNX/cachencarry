# Cache & Carry website: static files only (repository Anarki-LNX/cachencarry, folder website/).
#
# Goes into the Caddyfile of the wetter-crinitz server (server/caddy/Caddyfile), below the
# other loopout.tech blocks. It needs one extra read-only volume on the caddy service in
# /opt/wetter-crinitz/docker-compose.yml:
#
#     - /opt/cachencarry-web:/srv/cachencarry:ro
#
# /opt/cachencarry-web/current is a symlink to releases/<id>/ and is swapped atomically by
# deploy/deploy.sh. Files must be world-readable (dirs 755, files 644): this Caddy runs
# with cap_drop ALL and cannot bypass file modes.
#
# No reverse_proxy: nothing here reaches a Cache & Carry server, an admin port or a home
# network. No access log (no `log` directive).
#
# The CSP allows exactly one outside origin: the privacy-enhanced YouTube player
# (frame-src https://www.youtube-nocookie.com). It is only put into the page after a
# visitor presses play on a video. Thumbnails are local files.

(cachencarry_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'; upgrade-insecure-requests"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), autoplay=(self \"https://www.youtube-nocookie.com\"), browsing-topics=(), camera=(), clipboard-read=(), clipboard-write=(self), display-capture=(), encrypted-media=(self \"https://www.youtube-nocookie.com\"), fullscreen=(self \"https://www.youtube-nocookie.com\"), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(self \"https://www.youtube-nocookie.com\"), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}
}

cachencarry.loopout.tech {
	import cachencarry_headers
	root * /srv/cachencarry/current
	encode zstd gzip

	# A static site: reading only.
	@write not method GET HEAD
	header @write Allow "GET, HEAD"
	respond @write 405

	# Files under /_astro/ carry a content hash in their name: keep them a year.
	# Pages are revalidated every time, so a new build shows at once.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@pages path / */ *.html
	header @pages Cache-Control "no-cache"
	@health path /build.json
	header @health Cache-Control "no-store"
	header ?Cache-Control "public, max-age=86400"

	try_files {path} {path}/
	file_server {
		hide .*
	}

	handle_errors {
		import cachencarry_headers
		header Cache-Control "no-cache"
		root * /srv/cachencarry/current
		@page404 {
			expression `{err.status_code} == 404`
			file /404.html
		}
		handle @page404 {
			rewrite * /404.html
			file_server
		}
		handle {
			header Content-Type "text/plain; charset=utf-8"
			respond "{err.status_code} {err.status_text}"
		}
	}
}
