[Unit]
Description=Cache & Carry LAN package cache
Documentation=https://github.com/Anarki-LNX/cachencarry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cachencarry
Group=cachencarry
ExecStart=/usr/local/bin/cachencarry serve -config /etc/cachencarry/config.yaml
# Optional overrides, e.g. CACHENCARRY_SECURITY_ADMIN_PASSWORD for first start.
EnvironmentFile=-/etc/cachencarry/cachencarry.env
Restart=on-failure
RestartSec=3
TimeoutStopSec=40
LimitNOFILE=65536

# Directories (created and owned by systemd)
StateDirectory=cachencarry
StateDirectoryMode=0750
LogsDirectory=cachencarry
LogsDirectoryMode=0750
ConfigurationDirectory=cachencarry
ConfigurationDirectoryMode=0750

# Hardening. All of these work in an unprivileged Proxmox LXC container.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
# If storage.path is outside /var/lib/cachencarry, allow it with a drop-in:
#   systemctl edit cachencarry
#   [Service]
#   ReadWritePaths=/mnt/cache

[Install]
WantedBy=multi-user.target
