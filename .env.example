# Copy to .env and adjust. All values are optional.

# Published port of the web interface and all cache endpoints.
CACHENCARRY_PORT=8080

# Where the cache lives. Empty = Docker named volume "cachencarry-data".
# For a bind mount use an absolute path that UID/GID 65532 may write to:
#   mkdir -p /srv/cachencarry && chown 65532:65532 /srv/cachencarry
#CACHENCARRY_DATA_DIR=/srv/cachencarry

# Password of the initial administrator "admin" (at least 10 characters).
# Only read on the very first start. Empty = use the setup wizard.
CACHENCARRY_ADMIN_PASSWORD=

# Upper limit for cached data (e.g. 500GB, 2TB). 0 = unlimited, the cache
# then only respects CACHENCARRY_MIN_FREE_SPACE.
CACHENCARRY_MAX_SIZE=0
CACHENCARRY_MIN_FREE_SPACE=10%

CACHENCARRY_LOG_LEVEL=info
CACHENCARRY_MEMORY_LIMIT=1g
TZ=Europe/Berlin
