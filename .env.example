# Copy to .env and adjust. All values are optional.

# Published port of the web interface and all cache endpoints.
UNICACHE_PORT=8080

# Where the cache lives. Empty = Docker named volume "unicache-data".
# For a bind mount use an absolute path that UID/GID 65532 may write to:
#   mkdir -p /srv/unicache && chown 65532:65532 /srv/unicache
#UNICACHE_DATA_DIR=/srv/unicache

# Password of the initial administrator "admin" (at least 10 characters).
# Only read on the very first start. Empty = use the setup wizard.
UNICACHE_ADMIN_PASSWORD=

# Upper limit for cached data (e.g. 500GB, 2TB). 0 = unlimited, the cache
# then only respects UNICACHE_MIN_FREE_SPACE.
UNICACHE_MAX_SIZE=0
UNICACHE_MIN_FREE_SPACE=10%

UNICACHE_LOG_LEVEL=info
UNICACHE_MEMORY_LIMIT=1g
TZ=Europe/Berlin
